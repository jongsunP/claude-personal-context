{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-sonnet-4-6",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-ansi",
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp"
      ],
      "env": {
        "FIGMA_API_KEY": "$FIGMA_API_KEY"
      }
    }
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  }
}
